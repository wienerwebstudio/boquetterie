# Bloomery – environment variables
# Copy this file to `.env.local` (never commit real secrets).
# Everything is optional except ADMIN_PASSWORD: without keys the shop runs with the
# JSON store, the mock payment provider, console e-mail and local uploads.

# ── Admin ───────────────────────────────────────────────────────────────────────
# Password for the admin area (/admin). Required – without it the admin login refuses every attempt.
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie (HMAC-SHA256). Use a long random string,
# e.g. `openssl rand -hex 32`. Falls back to ADMIN_PASSWORD when unset. Changing it logs everyone out.
ADMIN_SECRET=

# ── Site ────────────────────────────────────────────────────────────────────────
# Public base URL of the shop (absolute links, sitemaps, metadata, payment return URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Customer accounts (magic link) ──────────────────────────────────────────────
# Signs the customer session cookie. ≥16 chars, e.g. `openssl rand -hex 32`.
# Falls back to ADMIN_SECRET; if neither is set, customer login is disabled with a clear message.
AUTH_SECRET=

# ── Payments (see docs/PAYMENTS.md) ─────────────────────────────────────────────
# Without keys the mock provider is used (orders are marked paid immediately, clearly labelled "Testmodus").
# Stripe: cards, Apple Pay, Google Pay, EPS, Klarna via the Payment Element.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint /api/webhooks/stripe (whsec_…).
STRIPE_WEBHOOK_SECRET=
# PayPal (Orders API v2). The PayPal method is hidden in checkout until both values are set.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# `sandbox` (default) or `live`.
PAYPAL_ENV=sandbox
# Webhook ID from the PayPal dashboard – enables signature verification of /api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=

# ── E-mail (see docs/MAIL.md) ───────────────────────────────────────────────────
# Resend API key. Without it every mail is only written to the server log (console provider).
RESEND_API_KEY=
# Sender (domain must be verified at Resend), reply-to and the internal address that gets
# a copy of every new order and B2B inquiry (empty = no internal mails).
MAIL_FROM="Bloomery <hallo@example.com>"
MAIL_REPLY_TO=
MAIL_ADMIN=
# Protects the cron endpoints /api/cron/* (`Authorization: Bearer <CRON_SECRET>`). `openssl rand -hex 32`.
CRON_SECRET=

# ── Database (see docs/DATABASE.md) ─────────────────────────────────────────────
# Postgres connection string. When set, all content and runtime data live in Postgres
# (run `npm run db:migrate` and `npm run db:seed` once). Unset = JSON files in content/ and data/.
DATABASE_URL=
# `require` or `disable` to force SSL on/off; unset = driver default.
DATABASE_SSL=
# Set to `false` behind a transaction pooler (pgbouncer); auto-detected for `?pgbouncer=true`.
DATABASE_PREPARE=
# Max connections per process (default 5).
DATABASE_POOL_MAX=

# ── Uploads (see docs/UPLOADS.md) ───────────────────────────────────────────────
# Default: files are stored in public/uploads. Set all four S3_* values to use S3 (or R2/MinIO).
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: custom endpoint (R2/MinIO, enables path-style), key prefix (default `uploads`),
# public base URL (CDN) and the hostname next/image may load from (required with S3).
S3_ENDPOINT=
S3_PREFIX=
S3_PUBLIC_URL=
UPLOADS_PUBLIC_HOST=

# ── Analytics (see docs/ANALYTICS.md) – only loaded after cookie consent ────────
# Plausible: the site domain as configured at Plausible; API/SRC only for self-hosted instances.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_API=
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Google Analytics 4 measurement ID (G-…).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
